# The Cognovis registry hosts the @polaris SDK packages used ONLY by the
# Aidbox live-mode dev app (src/live, devDependencies). Authentication comes
# from the developer's own ~/.npmrc — never put a token in this file.
@polaris:registry=https://npm.cognovis.de
# Estate FHIR TypeScript generator (@cognovis/codegen). Same rule: no token here.
@cognovis:registry=https://npm.cognovis.de
