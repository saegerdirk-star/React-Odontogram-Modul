# Aidbox live mode (bead odontogram-6fi) — copy to `.env` and fill in.
#
# `.env` is git-ignored. NEVER commit a filled-in copy, and never paste a real
# secret into this example file.
#
# THE CREDENTIALS BELONG TO A SCOPED MACHINE CLIENT, NOT TO AN ADMIN.
# The `odontogram-live` client authenticates with HTTP Basic and is limited by
# an Aidbox AccessPolicy to GET/PUT/POST/PATCH on
#   /fhir/Patient, /fhir/Observation, /fhir/Condition,
#   /fhir/ServiceRequest, /fhir/CarePlan
# and nothing else. An admin account (or any client with a wider scope) must
# never be configured here: this app runs in a browser, so whatever is put in
# these variables is compiled into the served bundle and is readable by anyone
# who can open the page. That is acceptable for a scoped development client
# against a local Aidbox, and is exactly why it must not be more than that.
#
# See docs/aidbox-live-mode.md for the setup and for what live mode can and
# cannot carry.

# The Aidbox base URL. The FHIR endpoint `/fhir` is appended by the app.
VITE_AIDBOX_BASE_URL=http://localhost:8081

# The scoped machine client's id and secret (Basic auth).
VITE_AIDBOX_CLIENT_ID=odontogram-live
VITE_AIDBOX_CLIENT_SECRET=

# The patient charted when the URL names none. `?patient=<id>` always wins.
VITE_DEFAULT_PATIENT_ID=
